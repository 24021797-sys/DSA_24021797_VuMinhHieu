#include<iostream>
using namespace std;

//duyet mang
void duyet(int *a,int n){
    for(int i=0;i<n;i++){
        cout<<a[i]<<" ";
    }
    cout<<endl;
}

//chen dau 
void chen_dau(int *&a,int &n, int x){
    int *a_new=new int[n+1];
    a_new[0]=x;
    for(int i=1;i<=n;i++){
        a_new[i]=a[i-1];
    }
    delete []a;
    a=a_new;
    n++;
}

//chen cuoi
void chen_cuoi(int *&a,int &n,int x){
    int *a_new=new int[n+1];
    for(int i=0;i<n;i++){
        a_new[i]=a[i];
    }
    a_new[n]=x;
    delete []a;
    a=a_new;
    n++;
}

//chen vi tri k 
void chen_pos(int *&a,int &n,int x,int pos){
    if(pos<0||pos>n) return ;
    pos--;
    int *a_new=new int[n+1];
    for(int i=0;i<pos;i++){
        a_new[i]=a[i];
    }
    a_new[pos]=x;
    for(int i=pos;i<n;i++){
        a_new[i+1]=a[i];
    }
    delete []a;
    a=a_new;
    n++;
}

//xoa_dau
void xoa_dau(int *&a,int &n){
    int *a_new=new int[n-1];
    for(int i=0;i<n-1;i++){
        a_new[i]=a[i+1];
    }
    delete []a;
    a=a_new;
    n--;
}

//xoa_cuoi
void xoa_cuoi(int *a, int &n) {
    if (n <= 0) return;
    n--;
}
//xoa_pos
void xoa_pos(int *&a,int &n,int pos){
    if(pos<0||pos>n) return ;
    pos--;
    int *a_new= new int[n-1];
    for(int i=0;i<pos;i++){
        a_new[i]=a[i];
    }
    for(int i=pos;i<n;i++){
        a_new[i]=a[i+1];
    }
    delete []a;
    a=a_new;
    n--;
}

int main(){
    int n;cin>>n;
    int *a=new int[n];
    for(int i=0;i<n;i++){
        cin>>a[i];
    }
    duyet(a,n);
    int x; cin>>x;
    int pos; cin>>pos;
    xoa_pos(a,n,pos);
    duyet(a,n);
    delete[]a;
    a=nullptr;
    return 0;
}
